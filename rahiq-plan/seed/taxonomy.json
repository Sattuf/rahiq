      ],
      "text": {
        "ar": "يحتوي على: {allergens}.",
        "tr": "İçerir: {allergens}.",
        "en": "Contains: {allergens}."
      }
    },
    {
      "code": "blend.pregnancy-medical",
      "appliesTo": [
        "honey_blend"
      ],
      "text": {
        "ar": "للحوامل والمرضعات ومن يتناول أدوية: يُستشار الطبيب قبل التناول.",
        "tr": "Hamile, emziren veya ilaç kullananlar tüketmeden önce doktora danışmalıdır.",
        "en": "If pregnant, breastfeeding or taking medication, consult a doctor before use."
      }
    },
    {
      "code": "honey.sugar-content",
      "appliesTo": [
        "honey",
        "comb_honey",
        "nuts_in_honey",
        "honey_blend"
      ],
      "text": {
        "ar": "يحتوي على سكريات طبيعية؛ يُراعى ذلك في الأنظمة الغذائية الخاصة.",
        "tr": "Doğal şeker içerir; özel diyetlerde dikkate alınmalıdır.",
        "en": "Contains natural sugars; consider this for special diets."
      }
    },
    {
      "code": "perfume.flammable",
      "appliesTo": [
        "perfume",
        "hair_home_mist"
      ],
      "text": {
        "ar": "قابل للاشتعال. يُحفظ بعيدًا عن الحرارة واللهب.",
        "tr": "Yanıcıdır. Isı ve alevden uzak tutunuz.",
        "en": "Flammable. Keep away from heat and flame."
      }
    },
    {
      "code": "perfume.external-use",
      "appliesTo": [
        "perfume",
        "attar",
        "hair_home_mist"
      ],
      "text": {
        "ar": "للاستعمال الخارجي فقط. تجنب ملامسة العينين. يُحفظ بعيدًا عن متناول الأطفال.",
        "tr": "Haricen kullanılır. Gözle temasından kaçınınız. Çocukların ulaşamayacağı yerde saklayınız.",
        "en": "For external use only. Avoid contact with eyes. Keep out of reach of children."
      }
    }
  ],
