  "warnings": [
    {
      "code": "honey.infant-under-12-months",
      "appliesTo": [
        "honey",
        "comb_honey",
        "nuts_in_honey",
        "honey_blend"
      ],
      "text": {
        "ar": "لا يُعطى للأطفال دون عمر السنة.",
        "tr": "1 yaşından küçük bebeklere verilmemelidir.",
        "en": "Not suitable for infants under 12 months."
      }
    },
    {
      "code": "allergen.contains",
