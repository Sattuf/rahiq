{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "Rahiq.Api" }
  },
  "ConnectionStrings": {
    "Postgres": "",
    "Redis": ""
  },
  "Auth": {
    "Issuer": "rahiq-api",
    "Audience": "rahiq-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "CheckBreachedPasswords": true
  },
  "Store": {
    "PublicWebUrl": "https://rahiq.example",
    "PublicApiUrl": "https://api.rahiq.example",
    "Currency": "TRY",
    "ReservationMinutes": 15,
    "MinShelfLifeDays": 60,
    "NearExpiryAlertDays": 90,
    "MaxQuantityPerVariant": 10,
    "MaxSamplesPerOrder": 3,
    "CodFee": 4990,
    "CodMaxOrderTotal": 500000,
    "RefundApprovalThreshold": 250000,
    "ReturnWindowDays": 14
  },
  "Seller": {
    "LegalName": "[Şirket unvanı]",
    "Address": "[Açık adres]",
    "Phone": "[Telefon]",
    "Email": "destek@rahiq.example",
    "DraftLegalTexts": true
  },
  "Payments": { "Provider": "sandbox" },
  "Shipping": { "Carrier": "sandbox" },
  "Storage": { "Provider": "s3", "Bucket": "rahiq" },
  "Search": { "MeilisearchUrl": "" },
  "Email": { "Transport": "smtp", "StaffAlertRecipients": [ "ops@rahiq.example" ] },
  "Web": { "AllowedOrigins": [ "https://rahiq.example" ] },
  "Channels": {
    "GraphApiVersion": "v23.0",
    "Telegram": { "BotToken": "", "WebhookSecret": "" },
    "Meta": { "AppSecret": "", "VerifyToken": "", "PageAccessToken": "", "InstagramAccessToken": "" },
    "WhatsApp": { "AppSecret": "", "VerifyToken": "", "AccessToken": "", "PhoneNumberId": "" }
  },
  "Agent": {
    "Enabled": false,
    "Model": "claude-opus-5",
    "Effort": "low",
    "MaxParallel": 4,
    "MaxRepliesPerHour": 30,
    "DefaultLanguage": "tr"
  },
  "Workers": { "Enabled": true },
  "Database": { "MigrateOnStartup": false },
  "AllowedHosts": "*"
}
