root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_prefer_braces = true:warning
# Names like Error and Result read naturally in C#; VB keyword clashes do not matter here.
dotnet_diagnostic.CA1716.severity = none
# ASP.NET Core has no synchronization context.
dotnet_diagnostic.CA2007.severity = none
# IEventHandler<T> and RequestHandlerDelegate are the clearest names for what they are.
dotnet_diagnostic.CA1711.severity = none

# Test names read as sentences: Reservation_is_released_when_payment_fails
[backend/tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA2007.severity = none
# IEventHandler<T> and RequestHandlerDelegate are the clearest names for what they are.
dotnet_diagnostic.CA1711.severity = none

# Tests use literal arrays freely.
[backend/tests/**.cs]
dotnet_diagnostic.CA1861.severity = none

[*.md]
trim_trailing_whitespace = false
