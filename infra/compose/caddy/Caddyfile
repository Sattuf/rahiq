# TLS is automatic (Let's Encrypt). Cloudflare sits in front for DNS, CDN and WAF (devops.md §2).
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip
	# Next.js sets its own CSP (per-request nonce); Caddy only adds transport headers.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	reverse_proxy web:3000 {
		lb_policy round_robin
		lb_try_duration 15s
		health_uri /robots.txt
		health_interval 10s
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	# Health, webhooks (payments, Telegram, Meta, WhatsApp), media and the public API. Admin calls come through the web BFF;
	# the one exception is the admin inbox's WebSocket (/hubs/conversations), which carries only "conversation X changed".
	@internal path /health/* /metrics*
	respond @internal 404
	reverse_proxy api:8080 {
		lb_policy round_robin
		lb_try_duration 15s
		health_uri /health/ready
		health_interval 10s
	}
}
