# /etc/rahiq/prod.env on the server (mode 600, owned by root). Real values come from the password manager, never git.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Postgres=Host=db.internal;Database=rahiq;Username=rahiq_app;Password=CHANGE_ME;SSL Mode=Require;Maximum Pool Size=50
Auth__SigningKey=CHANGE_ME_64_RANDOM_BYTES_BASE64
Store__PublicWebUrl=https://rahiq.com.tr
Store__PublicApiUrl=https://api.rahiq.com.tr
Web__AllowedOrigins__0=https://rahiq.com.tr
Web__RevalidateSecret=CHANGE_ME
Seller__LegalName=CHANGE_ME
Seller__Address=CHANGE_ME
Seller__Phone=CHANGE_ME
Seller__Email=destek@rahiq.com.tr
Seller__TaxOffice=CHANGE_ME
Seller__TaxNumber=CHANGE_ME
Seller__Mersis=CHANGE_ME
Seller__EtbisNumber=CHANGE_ME
Seller__Kep=CHANGE_ME
Seller__DraftLegalTexts=true
Payments__Provider=iyzico
Payments__IyzicoBaseUrl=https://api.iyzipay.com
Payments__IyzicoApiKey=CHANGE_ME
Payments__IyzicoSecretKey=CHANGE_ME
Shipping__Carrier=sandbox
Shipping__WebhookSecret=CHANGE_ME
Storage__Provider=s3
Storage__Bucket=rahiq
Storage__ServiceUrl=https://ACCOUNT.r2.cloudflarestorage.com
Storage__AccessKey=CHANGE_ME
Storage__SecretKey=CHANGE_ME
Storage__PublicBaseUrl=https://media.rahiq.com.tr
Search__MeilisearchKey=CHANGE_ME
Email__Transport=smtp
Email__Host=smtp.example
Email__Port=587
Email__UseTls=true
Email__Username=CHANGE_ME
Email__Password=CHANGE_ME
Email__FromAddress=siparis@rahiq.com.tr
Email__StaffAlertRecipients__0=ops@rahiq.com.tr
# Conversations (ADR-019). A channel stays off (its webhook answers 404) until its secrets are set.
Agent__Enabled=true
Agent__ApiKey=CHANGE_ME_ANTHROPIC_API_KEY
Channels__Telegram__BotToken=CHANGE_ME_FROM_BOTFATHER
Channels__Telegram__WebhookSecret=CHANGE_ME_32_RANDOM_CHARS_A_Z_0_9
Channels__Meta__AppSecret=CHANGE_ME
Channels__Meta__VerifyToken=CHANGE_ME_RANDOM
Channels__Meta__PageAccessToken=CHANGE_ME
Channels__Meta__InstagramAccessToken=
Channels__WhatsApp__AppSecret=CHANGE_ME
Channels__WhatsApp__VerifyToken=CHANGE_ME_RANDOM
Channels__WhatsApp__AccessToken=CHANGE_ME_SYSTEM_USER_TOKEN
Channels__WhatsApp__PhoneNumberId=CHANGE_ME
Serilog__WriteTo__1__Name=Seq
Serilog__WriteTo__1__Args__serverUrl=http://seq.internal:5341
